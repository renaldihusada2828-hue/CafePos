# ─────────────────────────────────────────────────────────────────
# MelekCafe POS — Environment Variables
# Salin file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke version control.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (browser-safe) ────────────────────────────────────
# Didapat dari: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE

# ── Supabase Service Role (SERVER ONLY) ───────────────────────
# JANGAN gunakan prefix NEXT_PUBLIC_ untuk key ini.
# Hanya digunakan di server (API routes, provisioning script).
# Didapat dari: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── URL Aplikasi (untuk redirect signout) ─────────────────────
# Development: http://localhost:3005
# Production:  https://nama-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# ── Provisioning (HAPUS setelah setup awal selesai) ───────────
# Hanya diperlukan saat menjalankan: node scripts/provision-users.mjs
# Login ID: huruf kecil, angka, underscore (3-40 karakter)
# Password: minimal 12 karakter, kombinasi huruf+angka+simbol
INITIAL_OWNER_LOGIN_ID=owner
INITIAL_OWNER_PASSWORD=GANTI_INI_MIN_12_KARAKTER_UNIK!
INITIAL_CASHIER_LOGIN_ID=kasir01
INITIAL_CASHIER_PASSWORD=GANTI_INI_MIN_12_KARAKTER_UNIK!
